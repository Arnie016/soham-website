# Local Supabase: npm run setup:supabase:local then npm run dev:supabase.
# Those commands inject the isolated local connection without saving secret values.
# Hosted Supabase: configure the following on the server/Vercel.
APP_URL=http://localhost:3100
STUDIO_BACKEND=email
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=the-project-publishable-or-legacy-anon-key
# SUPABASE_SECRET_KEY=the-server-secret-or-legacy-service-role-key
# Never prefix the server secret with NEXT_PUBLIC_.
# Set a private random value before production, for hashed rate-limit keys.
# RATE_LIMIT_SECRET=
# The old standalone local preview remains available with STUDIO_BACKEND=local.
# Private workspaces on Vercel require Supabase.
# The public launch uses STUDIO_BACKEND=email to forward enquiries without a database.
# Email mode does not enable client accounts or save a studio copy.

# Enquiry notifications use FormSubmit; recipient confirms the first activation email.
# Set disabled only for local automated tests; never claim delivery in this mode.
EMAIL_TRANSPORT=disabled
