{
  "name": "soham-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "setup": "tsx scripts/setup.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\" \"scripts/*.ts\" \"tests/*.ts\" \"*.md\" \"docs/**/*.md\" \"*.json\" next.config.ts",
    "dev:supabase": "tsx scripts/supabase-local.ts",
    "setup:supabase:local": "tsx scripts/supabase-local.ts setup",
    "setup:supabase": "tsx scripts/setup-supabase.ts",
    "test:supabase": "tsx scripts/test-supabase.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.186.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
